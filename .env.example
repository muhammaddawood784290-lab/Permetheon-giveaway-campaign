# Environment variables referenced in the project via process.env
# https://vitejs.dev/guide/env.html#env-file-basics

# Supabase configuration - values from your Supabase project
# These should be set according to your Supabase project setup
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_URL=your-supabase-url

# Internal Supabase project ID
SUPABASE_PROJECT_ID=your-project-id

# Supabase URL (also used for Edge Functions)
SUPABASE_URL=your-supabase-url

# Edge Function endpoint for giveaway submissions (public, non-secret).
SUPABASE_EDGE_FUNCTION_URL=https://aznldzafansjgfcxnntj.supabase.co/functions/v1/submit-giveaway
VITE_SUPABASE_EDGE_FUNCTION_URL=https://aznldzafansjgfcxnntj.supabase.co/functions/v1/submit-giveaway

# Note: SUPABASE_SERVICE_ROLE_KEY is for server-side only (Edge Functions)
# It is NOT checked into this repository and must be set locally.
